<script>
  // ---- CONFIG ----
  const SB_URL = 'https://hteopuanhychwuqysckl.supabase.co';
  const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh0ZW9wdWFuaHljaHd1cXlzY2tsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgzMTM2NjUsImV4cCI6MjA5Mzg4OTY2NX0.LEo3tiZWrCOexDaa1sW4-0mOGZe3i00vUrWzzpa_EBc';
  const CID = 3; // Venice Executive Driver
  const ADMIN_PIN = '4752';
  const H = { 'Content-Type':'application/json','apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY };

  async function sbGet(t,p){const r=await fetch(SB_URL+'/rest/v1/'+t+'?'+(p||''),{headers:{...H,'Prefer':'return=representation'}});return await r.json();}
  async function sbInsert(t,d){const r=await fetch(SB_URL+'/rest/v1/'+t,{method:'POST',headers:{...H,'Prefer':'return=representation'},body:JSON.stringify(d)});return await r.json();}
  async function sbUpdate(t,id,d){const r=await fetch(SB_URL+'/rest/v1/'+t+'?id=eq.'+id,{method:'PATCH',headers:{...H,'Prefer':'return=representation'},body:JSON.stringify(d)});return await r.json();}
  async function sbDelete(t,id){await fetch(SB_URL+'/rest/v1/'+t+'?id=eq.'+id,{method:'DELETE',headers:H});}

  let corse = [];
  let corsaEditId = null;
  let completaId = null;
  let agendaOffset = 0;
  let periodoRep = 'mese';
  let pinBuffer = '';
  let adminSbloccato = false;

  const MESI = ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'];
  const GIORNI = ['Dom','Lun','Mar','Mer','Gio','Ven','Sab'];

  function fmt(n){return parseFloat(n||0).toFixed(2).replace('.',',')+' €';}
  function dateStr(d){return d.toISOString().split('T')[0];}
  function fmtData(ds){const d=new Date(ds+'T12:00:00');return GIORNI[d.getDay()]+' '+d.getDate()+' '+MESI[d.getMonth()];}
  function oggiStr(){return dateStr(new Date());}

  let toastTimer;
  function showToast(msg,tipo){const t=document.getElementById('toast');t.textContent=msg;t.className=tipo?'show '+tipo:'show';clearTimeout(toastTimer);toastTimer=setTimeout(()=>{t.className='';},2400);}
  function chiudiOverlay(id){document.getElementById(id).classList.remove('show');}
  function apriOverlay(id){document.getElementById(id).classList.add('show');}

  function showScreen(name){
    document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
    document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
    document.getElementById('screen-'+name).classList.add('active');
    document.getElementById('tab-'+name).classList.add('active');
    if(name==='oggi')   buildOggi();
    if(name==='agenda') buildAgenda();
    if(name==='corse')  buildCorse();
    if(name==='report') aggiornaReport();
    if(name==='admin')  buildAdmin();
  }

  async function init(){
    const d=new Date();
    document.getElementById('today-label').textContent=d.getDate()+'/'+(d.getMonth()+1)+'/'+d.getFullYear();
    document.getElementById('c-data').value=dateStr(d);
    try{
      corse=await sbGet('corse','commerciante_id=eq.'+CID+'&order=data.desc,ora.desc');
      buildOggi();
      document.getElementById('loading').style.display='none';
    }catch(e){
      document.getElementById('loading').innerHTML='<p style="color:var(--danger);padding:20px;text-align:center">Errore connessione Supabase.</p>';
    }
  }

  // ---- OGGI ----
  function buildOggi(){
    const oggi=oggiStr();
    const corseOggi=corse.filter(c=>c.data===oggi);
    const completate=corseOggi.filter(c=>c.stato==='completata');
    const incasso=completate.reduce((s,c)=>s+parseFloat(c.importo||0),0);
    const costiTot=completate.reduce((s,c)=>s+parseFloat(c.costo_carburante||0)+parseFloat(c.costo_pedaggi||0)+parseFloat(c.altri_costi||0),0);
    const margine=incasso-costiTot;
    const km=completate.reduce((s,c)=>s+parseFloat(c.km||0),0);
    const pending=corseOggi.filter(c=>c.stato==='prenotata').length;

    document.getElementById('oggi-incasso').textContent=fmt(incasso);
    document.getElementById('oggi-margine').textContent=fmt(margine);
    document.getElementById('oggi-corse').textContent=completate.length;
    document.getElementById('oggi-km').textContent=Math.round(km);
    document.getElementById('oggi-pending').textContent=pending;

    if(!corseOggi.length){
      document.getElementById('oggi-list').innerHTML='<div class="empty-state"><div class="empty-icon">🚗</div>Nessuna corsa oggi</div>';
      return;
    }
    document.getElementById('oggi-list').innerHTML=corseOggi.map(c=>buildCorsaCard(c)).join('');
  }

  // ---- CORSA CARD ----
  function buildCorsaCard(c){
    const costi=parseFloat(c.costo_carburante||0)+parseFloat(c.costo_pedaggi||0)+parseFloat(c.altri_costi||0);
    const margine=parseFloat(c.importo||0)-costi;
    return '<div class="corsa-card '+c.stato+(c.da_online?' online':'')+'" onclick="apriModificaCorsa('+c.id+')">' +
      '<div class="corsa-header"><div class="corsa-cliente">'+c.cliente+'</div><span class="corsa-stato '+c.stato+'">'+c.stato+'</span></div>' +
      '<div class="corsa-rotta"><span>'+c.partenza+'</span><span class="corsa-rotta-arrow">→</span><span>'+c.destinazione+'</span></div>' +
      '<div class="corsa-dettagli">' +
        '<div class="corsa-det">📅 <strong>'+fmtData(c.data)+'</strong></div>' +
        '<div class="corsa-det">🕐 <strong>'+c.ora+'</strong></div>' +
        '<div class="corsa-det">🚗 <strong>'+c.servizio+'</strong></div>' +
        (c.km?'<div class="corsa-det">📍 <strong>'+c.km+' km</strong></div>':'') +
      '</div>' +
      '<div class="corsa-footer">' +
        '<div><div class="corsa-importo">'+fmt(c.importo)+'</div>' +
        (c.stato==='completata'?'<div class="corsa-margine">Margine: '+fmt(margine)+'</div>':'')+'</div>' +
        '<div class="corsa-actions">' +
        (c.stato==='prenotata'?'<button class="btn-completa" onclick="event.stopPropagation();apriCompleta('+c.id+')">✓ Completa</button>':'') +
        '<button class="btn-edit-c" onclick="event.stopPropagation();apriModificaCorsa('+c.id+')">✏️</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  // ---- AGENDA ----
  function getLunedi(offset){const d=new Date(),day=d.getDay();d.setDate(d.getDate()+(day===0?-6:1-day)+offset*7);d.setHours(0,0,0,0);return d;}
  function cambiaSettimana(dir){agendaOffset+=dir;buildAgenda();}

  function buildAgenda(){
    const lun=getLunedi(agendaOffset);
    const dom=new Date(lun);dom.setDate(dom.getDate()+6);
    const oggi=oggiStr();
    document.getElementById('agenda-range').textContent=lun.getDate()+' '+MESI[lun.getMonth()]+' – '+dom.getDate()+' '+MESI[dom.getMonth()];

    const dalStr=dateStr(lun),alStr=dateStr(dom);
    const corseSettimana=corse.filter(c=>c.data>=dalStr&&c.data<=alStr&&c.stato!=='annullata').sort((a,b)=>a.data.localeCompare(b.data)||a.ora.localeCompare(b.ora));
    const totIncasso=corseSettimana.filter(c=>c.stato==='completata').reduce((s,c)=>s+parseFloat(c.importo||0),0);
    const nPrenotate=corseSettimana.filter(c=>c.stato==='prenotata').length;

    document.getElementById('agenda-stats').innerHTML=
      '<div class="agenda-stat"><div class="agenda-stat-val">'+corseSettimana.length+'</div><div class="agenda-stat-lbl">Totale</div></div>'+
      '<div class="agenda-stat"><div class="agenda-stat-val" style="color:var(--gold)">'+nPrenotate+'</div><div class="agenda-stat-lbl">In attesa</div></div>'+
      '<div class="agenda-stat"><div class="agenda-stat-val" style="color:var(--success)">'+fmt(totIncasso)+'</div><div class="agenda-stat-lbl">Incassato</div></div>';

    let html='';
    for(let i=0;i<7;i++){
      const d=new Date(lun);d.setDate(d.getDate()+i);
      const ds=dateStr(d);const isOggi=ds===oggi;
      const corseG=corseSettimana.filter(c=>c.data===ds);
      html+='<div class="agenda-giorno">';
      html+='<div class="agenda-giorno-header"><div class="agenda-giorno-data">'+GIORNI[d.getDay()]+' '+d.getDate()+' '+MESI[d.getMonth()]+'</div>'+(isOggi?'<span class="agenda-oggi-badge">OGGI</span>':'')+'<div class="agenda-giorno-line"></div></div>';
      if(!corseG.length){html+='<div class="agenda-vuoto">Nessuna corsa</div>';}
      else{corseG.forEach(c=>{html+='<div class="agenda-corsa" onclick="apriModificaCorsa('+c.id+')">'+'<div class="agenda-ora">'+c.ora+'</div><div class="agenda-info"><div class="agenda-cliente">'+c.cliente+'</div><div class="agenda-rotta">'+c.partenza+' → '+c.destinazione+'</div><div class="agenda-serv">'+c.servizio+'</div>'+(c.da_online?'<div class="agenda-online">🌐 Prenotazione online</div>':'')+'</div><div><div class="agenda-importo">'+fmt(c.importo)+'</div></div></div>';});}
      html+='</div>';
    }
    document.getElementById('agenda-container').innerHTML=html;
  }

  // ---- CORSE ----
  function buildCorse(){
    if(!corse.length){document.getElementById('corse-container').innerHTML='<div class="empty-state"><div class="empty-icon">🚗</div>Nessuna corsa registrata</div>';return;}
    const sorted=corse.slice().sort((a,b)=>b.data.localeCompare(a.data)||b.ora.localeCompare(a.ora));
    document.getElementById('corse-container').innerHTML=sorted.map(c=>buildCorsaCard(c)).join('');
  }

  // ---- NUOVA/MODIFICA CORSA ----
  function apriNuovaCorsa(){
    corsaEditId=null;
    document.getElementById('corsa-title').textContent='Nuova corsa';
    document.getElementById('corsa-sub').textContent='Registra una corsa manualmente';
    ['c-cliente','c-telefono','c-partenza','c-destinazione','c-importo','c-km','c-note'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('c-data').value=oggiStr();
    document.getElementById('c-ora').value='';
    document.getElementById('c-servizio').value='Trasferimento Aeroporto';
    document.getElementById('btn-elimina-corsa').style.display='none';
    apriOverlay('corsa-overlay');
  }

  function apriModificaCorsa(id){
    const c=corse.find(x=>x.id===id);if(!c)return;
    corsaEditId=id;
    document.getElementById('corsa-title').textContent='Modifica corsa';
    document.getElementById('corsa-sub').textContent=c.cliente+' · '+fmtData(c.data);
    document.getElementById('c-cliente').value=c.cliente||'';
    document.getElementById('c-telefono').value=c.telefono||'';
    document.getElementById('c-servizio').value=c.servizio||'Trasferimento Aeroporto';
    document.getElementById('c-data').value=c.data||'';
    document.getElementById('c-ora').value=c.ora||'';
    document.getElementById('c-partenza').value=c.partenza||'';
    document.getElementById('c-destinazione').value=c.destinazione||'';
    document.getElementById('c-importo').value=c.importo||'';
    document.getElementById('c-km').value=c.km||'';
    document.getElementById('c-note').value=c.note||'';
    document.getElementById('btn-elimina-corsa').style.display='block';
    apriOverlay('corsa-overlay');
  }

  async function salvaCorsa(){
    const cliente=document.getElementById('c-cliente').value.trim();
    const data=document.getElementById('c-data').value;
    const ora=document.getElementById('c-ora').value;
    const partenza=document.getElementById('c-partenza').value.trim();
    const destinazione=document.getElementById('c-destinazione').value.trim();
    const importo=parseFloat(document.getElementById('c-importo').value)||0;
    if(!cliente||!data||!ora||!partenza||!destinazione){showToast('Compila tutti i campi obbligatori','undo');return;}

    const dati={
      commerciante_id:CID,cliente,
      telefono:document.getElementById('c-telefono').value.trim(),
      servizio:document.getElementById('c-servizio').value,
      data,ora,partenza,destinazione,importo,
      km:parseFloat(document.getElementById('c-km').value)||0,
      note:document.getElementById('c-note').value.trim(),
      stato:'prenotata',da_online:false
    };

    if(corsaEditId){
      await sbUpdate('corse',corsaEditId,dati);
      const idx=corse.findIndex(x=>x.id===corsaEditId);
      if(idx!==-1)corse[idx]={...corse[idx],...dati};
    }else{
      const nuova=await sbInsert('corse',dati);
      if(nuova&&nuova[0])corse.unshift(nuova[0]);
    }
    chiudiOverlay('corsa-overlay');
    buildOggi();showToast('✓ Corsa salvata');
  }

  async function eliminaCorsa(){
    if(!confirm('Eliminare questa corsa?'))return;
    await sbDelete('corse',corsaEditId);
    corse=corse.filter(x=>x.id!==corsaEditId);
    chiudiOverlay('corsa-overlay');buildOggi();buildCorse();
    showToast('Corsa eliminata','undo');
  }

  // ---- COMPLETA CORSA ----
  function apriCompleta(id){
    const c=corse.find(x=>x.id===id);if(!c)return;
    completaId=id;
    document.getElementById('completa-sub').textContent=c.cliente+' · '+c.partenza+' → '+c.destinazione;
    document.getElementById('comp-importo').value=c.importo||'';
    document.getElementById('comp-carburante').value='';
    document.getElementById('comp-pedaggi').value='';
    document.getElementById('comp-altri').value='';
    document.getElementById('comp-km').value=c.km||'';
    document.getElementById('completa-riepilogo').innerHTML=
      '<div class="costi-title">Riepilogo corsa</div>'+
      '<div class="costi-row"><span class="costi-label">Cliente</span><span class="costi-val">'+c.cliente+'</span></div>'+
      '<div class="costi-row"><span class="costi-label">Servizio</span><span class="costi-val">'+c.servizio+'</span></div>'+
      '<div class="costi-row"><span class="costi-label">Data</span><span class="costi-val">'+fmtData(c.data)+' alle '+c.ora+'</span></div>'+
      '<div class="costi-row"><span class="costi-label">Rotta</span><span class="costi-val">'+c.partenza+' → '+c.destinazione+'</span></div>';
    document.getElementById('margine-preview').style.display='none';
    apriOverlay('completa-overlay');
  }

  function aggiornaMarginePreview(){
    const importo=parseFloat(document.getElementById('comp-importo').value)||0;
    const carb=parseFloat(document.getElementById('comp-carburante').value)||0;
    const ped=parseFloat(document.getElementById('comp-pedaggi').value)||0;
    const altri=parseFloat(document.getElementById('comp-altri').value)||0;
    const costiTot=carb+ped+altri;
    const margine=importo-costiTot;
    document.getElementById('margine-preview').style.display='block';
    document.getElementById('mp-incasso').textContent=fmt(importo);
    document.getElementById('mp-costi').textContent=fmt(costiTot);
    document.getElementById('mp-margine').textContent=fmt(margine);
    document.getElementById('mp-margine').style.color=margine>=0?'var(--success)':'var(--danger)';
  }

  async function confermaCompleta(){
    const importo=parseFloat(document.getElementById('comp-importo').value)||0;
    const carburante=parseFloat(document.getElementById('comp-carburante').value)||0;
    const pedaggi=parseFloat(document.getElementById('comp-pedaggi').value)||0;
    const altri=parseFloat(document.getElementById('comp-altri').value)||0;
    const km=parseFloat(document.getElementById('comp-km').value)||0;
    if(!importo){showToast('Inserisci l\'importo finale','undo');return;}
    await sbUpdate('corse',completaId,{stato:'completata',importo,costo_carburante:carburante,costo_pedaggi:pedaggi,altri_costi:altri,km});
    const idx=corse.findIndex(x=>x.id===completaId);
    if(idx!==-1)corse[idx]={...corse[idx],stato:'completata',importo,costo_carburante:carburante,costo_pedaggi:pedaggi,altri_costi:altri,km};
    chiudiOverlay('completa-overlay');buildOggi();buildCorse();
    showToast('✓ Corsa completata · Margine: '+fmt(importo-carburante-pedaggi-altri));
  }

  // ---- REPORT ----
  function setPeriodo(p,btn){periodoRep=p;document.querySelectorAll('.period-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');aggiornaReport();}

  function filtraCorse(){
    const ora=new Date(),oggi=new Date(ora.getFullYear(),ora.getMonth(),ora.getDate());
    const completate=corse.filter(c=>c.stato==='completata');
    return completate.filter(c=>{
      const d=new Date(c.data+'T12:00:00');
      if(periodoRep==='oggi')return d>=oggi;
      if(periodoRep==='settimana'){const i=new Date(oggi);i.setDate(oggi.getDate()-(oggi.getDay()===0?6:oggi.getDay()-1));return d>=i;}
      if(periodoRep==='mese')return d.getMonth()===ora.getMonth()&&d.getFullYear()===ora.getFullYear();
      if(periodoRep==='anno')return d.getFullYear()===ora.getFullYear();
      return true;
    });
  }

  function aggiornaReport(){
    const filtrate=filtraCorse();
    if(!filtrate.length){
      ['r-incasso','r-margine','r-corse','r-km','r-media','r-margine-medio','r-costi'].forEach(id=>document.getElementById(id).textContent='—');
      document.getElementById('report-list').innerHTML='<div class="empty-state">Nessuna corsa completata nel periodo</div>';
      return;
    }
    const totIncasso=filtrate.reduce((s,c)=>s+parseFloat(c.importo||0),0);
    const totCosti=filtrate.reduce((s,c)=>s+parseFloat(c.costo_carburante||0)+parseFloat(c.costo_pedaggi||0)+parseFloat(c.altri_costi||0),0);
    const totMargine=totIncasso-totCosti;
    const totKm=filtrate.reduce((s,c)=>s+parseFloat(c.km||0),0);
    const n=filtrate.length;

    document.getElementById('r-incasso').textContent=fmt(totIncasso);
    document.getElementById('r-margine').textContent=fmt(totMargine);
    document.getElementById('r-corse').textContent=n;
    document.getElementById('r-km').textContent=Math.round(totKm)+' km';
    document.getElementById('r-media').textContent=fmt(totIncasso/n);
    document.getElementById('r-margine-medio').textContent=fmt(totMargine/n)+' ('+Math.round((totMargine/totIncasso)*100)+'%)';
    document.getElementById('r-costi').textContent=fmt(totCosti);

    const sorted=filtrate.slice().sort((a,b)=>b.data.localeCompare(a.data));
    document.getElementById('report-list').innerHTML=sorted.map(c=>{
      const costi=parseFloat(c.costo_carburante||0)+parseFloat(c.costo_pedaggi||0)+parseFloat(c.altri_costi||0);
      const marg=parseFloat(c.importo||0)-costi;
      return '<div class="report-row"><div><div class="r-data">'+fmtData(c.data)+' · '+c.ora+'</div><div class="r-cliente">'+c.cliente+'</div><div class="r-rotta">'+c.partenza+' → '+c.destinazione+'</div></div><div><div class="r-importo">'+fmt(c.importo)+'</div><div class="r-margine">'+fmt(marg)+'</div></div></div>';
    }).join('');
  }

  // ---- ADMIN ----
  function apriAdmin(){if(adminSbloccato){showScreen('admin');return;}pinBuffer='';aggiornaPin();document.getElementById('pin-error').textContent='';apriOverlay('pin-overlay');}
  function pinPress(n){if(!n||pinBuffer.length>=4)return;pinBuffer+=n;aggiornaPin();if(pinBuffer.length===4){setTimeout(()=>{if(pinBuffer===ADMIN_PIN){chiudiOverlay('pin-overlay');adminSbloccato=true;showScreen('admin');}else{document.getElementById('pin-error').textContent='PIN errato.';pinBuffer='';aggiornaPin();}},200);}}
  function pinDel(){pinBuffer=pinBuffer.slice(0,-1);aggiornaPin();}
  function aggiornaPin(){for(let i=0;i<4;i++)document.getElementById('d'+i).classList.toggle('filled',i<pinBuffer.length);}

  function buildAdmin(){
    const completate=corse.filter(c=>c.stato==='completata');
    const totIncasso=completate.reduce((s,c)=>s+parseFloat(c.importo||0),0);
    const totCosti=completate.reduce((s,c)=>s+parseFloat(c.costo_carburante||0)+parseFloat(c.costo_pedaggi||0)+parseFloat(c.altri_costi||0),0);
    const totKm=completate.reduce((s,c)=>s+parseFloat(c.km||0),0);
    const online=corse.filter(c=>c.da_online).length;
    document.getElementById('admin-stats').innerHTML=
      '<div class="admin-row"><div><div class="admin-row-name">Corse totali registrate</div></div><div class="admin-row-val">'+corse.length+'</div></div>'+
      '<div class="admin-row"><div><div class="admin-row-name">Corse completate</div></div><div class="admin-row-val">'+completate.length+'</div></div>'+
      '<div class="admin-row"><div><div class="admin-row-name">Prenotazioni online</div></div><div class="admin-row-val">'+online+'</div></div>'+
      '<div class="admin-row"><div><div class="admin-row-name">Incasso totale storico</div></div><div class="admin-row-val" style="color:var(--gold)">'+fmt(totIncasso)+'</div></div>'+
      '<div class="admin-row"><div><div class="admin-row-name">Costi totali storici</div></div><div class="admin-row-val" style="color:var(--danger)">'+fmt(totCosti)+'</div></div>'+
      '<div class="admin-row"><div><div class="admin-row-name">Km totali percorsi</div></div><div class="admin-row-val" style="color:var(--info)">'+Math.round(totKm)+' km</div></div>';
  }

  async function resetCorse(){
    const ids=corse.filter(c=>c.stato==='completata').map(c=>c.id);
    for(const id of ids)await sbDelete('corse',id);
    corse=corse.filter(c=>c.stato!=='completata');
    buildAdmin();showToast('Storico eliminato','undo');
  }

  document.addEventListener('DOMContentLoaded',init);
</script>
</body>
</html>
