<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VED Driver">
<title>Venice Executive Driver — Gestionale</title>
<style>
  :root {
    --gold: #C9A84C; --gold-light: #E8D5A3; --gold-dark: #9A7A2E;
    --black: #0A0A0A; --dark: #111111; --dark2: #1A1A1A; --dark3: #242424; --dark4: #2E2E2E;
    --text: #F5F5F0; --text2: #A0A090; --text3: #6A6A60;
    --border: #2A2A28; --border2: #333330;
    --success: #4CAF7D; --danger: #E05555; --warning: #E09030; --info: #5B9BD5;
    --radius: 12px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--black); color: var(--text); min-height: 100vh; max-width: 480px; margin: 0 auto; }

  .top-bar { background: var(--dark); padding: 16px 18px 12px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 10; }
  .salon-name { font-size: 17px; font-weight: 800; letter-spacing: 0.1em; background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .salon-sub { font-size: 9px; color: var(--text3); letter-spacing: 0.18em; text-transform: uppercase; margin-top: 1px; }
  .top-date { font-size: 12px; color: var(--text3); }

  .nav-tabs { display: flex; background: var(--dark); border-bottom: 1px solid var(--border); position: sticky; top: 63px; z-index: 10; }
  .nav-tab { flex: 1; padding: 10px 2px 8px; font-size: 9px; color: var(--text3); text-align: center; cursor: pointer; border: none; background: transparent; display: flex; flex-direction: column; align-items: center; gap: 3px; border-bottom: 2px solid transparent; letter-spacing: 0.04em; text-transform: uppercase; }
  .nav-tab svg { width: 18px; height: 18px; }
  .nav-tab.active { color: var(--gold); border-bottom-color: var(--gold); }

  .screen { display: none; padding: 16px; }
  .screen.active { display: block; }

  /* DAY TOTAL */
  .day-total { background: var(--dark); border-radius: var(--radius); padding: 16px 18px; display: flex; justify-content: space-between; margin-bottom: 14px; border: 1px solid var(--border); position: relative; overflow: hidden; }
  .day-total::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--gold-dark), var(--gold-light), var(--gold-dark)); }
  .day-total .label { font-size: 10px; color: var(--text3); margin-bottom: 4px; letter-spacing: 0.08em; text-transform: uppercase; }
  .day-total .value { font-size: 22px; font-weight: 700; color: var(--text); }
  .day-total .profit { font-size: 20px; font-weight: 700; color: var(--success); }

  .stat-mini-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 14px; }
  .stat-mini { background: var(--dark); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 12px; text-align: center; }
  .stat-mini-val { font-size: 18px; font-weight: 700; color: var(--text); }
  .stat-mini-lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px; }

  .cat-label { font-size: 10px; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: 0.14em; margin: 16px 0 10px; display: flex; align-items: center; gap: 10px; }
  .cat-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  /* CORSA CARD */
  .corsa-card { background: var(--dark); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 16px; margin-bottom: 10px; position: relative; overflow: hidden; cursor: pointer; transition: border-color 0.15s; }
  .corsa-card:active { border-color: var(--gold); }
  .corsa-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
  .corsa-card.prenotata::before { background: var(--gold); }
  .corsa-card.completata::before { background: var(--success); }
  .corsa-card.annullata::before { background: var(--text3); opacity: 0.4; }
  .corsa-card.online::after { content: '🌐'; position: absolute; top: 12px; right: 14px; font-size: 12px; }
  .corsa-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 8px; padding-right: 24px; }
  .corsa-cliente { font-size: 15px; font-weight: 700; color: var(--text); }
  .corsa-stato { font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.05em; flex-shrink: 0; }
  .corsa-stato.prenotata  { background: #1A1500; color: var(--gold); }
  .corsa-stato.completata { background: #0D1A12; color: var(--success); }
  .corsa-stato.annullata  { background: var(--dark3); color: var(--text3); }
  .corsa-rotta { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text2); margin-bottom: 6px; }
  .corsa-rotta-arrow { color: var(--text3); }
  .corsa-dettagli { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .corsa-det { font-size: 11px; color: var(--text3); }
  .corsa-det strong { color: var(--text2); }
  .corsa-footer { display: flex; align-items: center; justify-content: space-between; }
  .corsa-importo { font-size: 16px; font-weight: 700; color: var(--gold); }
  .corsa-margine { font-size: 12px; color: var(--success); }
  .corsa-actions { display: flex; gap: 6px; }
  .btn-completa { padding: 7px 12px; background: var(--success); color: #fff; border: none; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; }
  .btn-edit-c { padding: 7px 10px; background: transparent; color: var(--text3); border: 1px solid var(--border); border-radius: 8px; font-size: 12px; cursor: pointer; }

  .btn-add-corsa { width: 100%; padding: 13px; background: transparent; border: 1px dashed var(--gold-dark); border-radius: var(--radius); color: var(--gold); font-size: 14px; font-weight: 600; cursor: pointer; margin-bottom: 14px; }

  /* OVERLAYS */
  .overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 50; align-items: flex-end; justify-content: center; }
  .overlay.show { display: flex; }
  .sheet { background: var(--dark2); border-radius: 22px 22px 0 0; padding: 10px 20px 40px; width: 100%; max-width: 480px; border-top: 1px solid var(--border2); max-height: 92vh; overflow-y: auto; }
  .sheet-handle { width: 36px; height: 4px; background: var(--border); border-radius: 2px; margin: 12px auto 20px; }
  .sheet h3 { font-size: 18px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .sheet p { font-size: 13px; color: var(--text3); margin-bottom: 16px; }
  .field-label { font-size: 11px; color: var(--text3); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.06em; }
  .field-input { width: 100%; padding: 13px 16px; border: 1px solid var(--border); border-radius: 12px; font-size: 15px; outline: none; background: var(--dark3); color: var(--text); margin-bottom: 12px; }
  .field-input:focus { border-color: var(--gold); }
  .field-select { width: 100%; padding: 13px 16px; border: 1px solid var(--border); border-radius: 12px; font-size: 15px; outline: none; background: var(--dark3); color: var(--text); margin-bottom: 12px; appearance: none; }
  .field-select:focus { border-color: var(--gold); }
  .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
  .btn-gold { width: 100%; padding: 14px; background: var(--gold); color: var(--black); border: none; border-radius: 12px; font-size: 15px; font-weight: 800; cursor: pointer; margin-top: 4px; }
  .btn-success { width: 100%; padding: 14px; background: var(--success); color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 800; cursor: pointer; margin-top: 4px; }
  .btn-danger { width: 100%; padding: 12px; background: transparent; color: var(--danger); border: 1px solid #3A2020; border-radius: 12px; font-size: 14px; cursor: pointer; margin-top: 8px; }
  .btn-cancel { width: 100%; padding: 12px; background: transparent; color: var(--text3); border: none; font-size: 15px; cursor: pointer; margin-top: 6px; }

  /* COSTI BOX */
  .costi-box { background: var(--dark3); border-radius: 12px; padding: 14px; border: 1px solid var(--border); margin-bottom: 14px; }
  .costi-title { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
  .costi-row { display: flex; justify-content: space-between; font-size: 13px; padding: 6px 0; border-bottom: 1px solid var(--border); }
  .costi-row:last-child { border-bottom: none; font-weight: 700; padding-top: 10px; font-size: 15px; }
  .costi-label { color: var(--text3); }
  .costi-val { color: var(--text); }
  .costi-val.green { color: var(--success); font-size: 17px; }
  .costi-val.red { color: var(--danger); }

  /* REPORT */
  .period-filter { display: flex; gap: 6px; margin-bottom: 16px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: none; }
  .period-filter::-webkit-scrollbar { display: none; }
  .period-btn { flex-shrink: 0; padding: 7px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid var(--border); background: var(--dark); color: var(--text3); }
  .period-btn.active { background: var(--gold); color: var(--black); border-color: var(--gold); }

  .stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 14px; }
  .stat-card { background: var(--dark); border-radius: var(--radius); padding: 14px; border: 1px solid var(--border); }
  .stat-card .s-label { font-size: 10px; color: var(--text3); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.06em; }
  .stat-card .s-value { font-size: 20px; font-weight: 700; color: var(--text); }
  .stat-card .s-value.gold { color: var(--gold); }
  .stat-card .s-value.green { color: var(--success); }
  .stat-card .s-value.info { color: var(--info); }

  .highlight { border-radius: var(--radius); padding: 14px 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 14px; border: 1px solid; }
  .highlight.gold { background: #1A1500; border-color: #3A3000; }
  .highlight.green { background: #0D1A12; border-color: #1A3A24; }
  .highlight.red { background: #1A0D0D; border-color: #3A1A1A; }
  .highlight .icon { font-size: 22px; }
  .highlight .h-label { font-size: 10px; color: var(--text3); margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.06em; }
  .highlight .h-value { font-size: 14px; font-weight: 600; }
  .highlight.gold .h-value { color: var(--gold); }
  .highlight.green .h-value { color: var(--success); }
  .highlight.red .h-value { color: var(--danger); }

  .report-list { background: var(--dark); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; margin-bottom: 10px; }
  .report-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .report-row:last-child { border-bottom: none; }
  .r-data { font-size: 11px; color: var(--gold); font-weight: 700; }
  .r-cliente { font-size: 13px; font-weight: 600; color: var(--text); margin: 2px 0; }
  .r-rotta { font-size: 11px; color: var(--text3); }
  .r-importo { font-size: 15px; font-weight: 700; color: var(--gold); text-align: right; }
  .r-margine { font-size: 11px; color: var(--success); text-align: right; margin-top: 2px; }

  /* AGENDA */
  .cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .cal-nav-btn { background: var(--dark); border: 1px solid var(--border); color: var(--text); border-radius: 10px; padding: 8px 14px; font-size: 18px; cursor: pointer; }
  .cal-week-label { font-size: 13px; font-weight: 700; color: var(--text); text-align: center; }
  .cal-week-label span { display: block; font-size: 10px; color: var(--text3); margin-top: 2px; }

  .agenda-stat-bar { display: flex; gap: 8px; margin-bottom: 14px; }
  .agenda-stat { flex: 1; background: var(--dark); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; text-align: center; }
  .agenda-stat-val { font-size: 18px; font-weight: 700; color: var(--text); }
  .agenda-stat-lbl { font-size: 9px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }

  .agenda-giorno { margin-bottom: 16px; }
  .agenda-giorno-header { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .agenda-giorno-data { font-size: 13px; font-weight: 700; color: var(--text); }
  .agenda-oggi-badge { font-size: 10px; font-weight: 700; color: var(--gold); background: #1A1500; border: 1px solid var(--gold-dark); border-radius: 6px; padding: 2px 8px; }
  .agenda-giorno-line { flex: 1; height: 1px; background: var(--border); }
  .agenda-vuoto { font-size: 12px; color: var(--text3); padding: 8px 0; font-style: italic; }

  .agenda-corsa { background: var(--dark); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; display: flex; align-items: center; gap: 12px; cursor: pointer; }
  .agenda-corsa:active { border-color: var(--gold); }
  .agenda-ora { font-size: 16px; font-weight: 800; color: var(--gold); width: 52px; flex-shrink: 0; }
  .agenda-info { flex: 1; }
  .agenda-cliente { font-size: 14px; font-weight: 700; color: var(--text); }
  .agenda-rotta { font-size: 11px; color: var(--text2); margin-top: 2px; }
  .agenda-serv { font-size: 10px; color: var(--text3); margin-top: 2px; }
  .agenda-importo { font-size: 15px; font-weight: 700; color: var(--gold); }
  .agenda-online { font-size: 11px; color: var(--info); margin-top: 2px; }

  /* PIN */
  .pin-dots { display: flex; gap: 14px; justify-content: center; margin: 24px 0 28px; }
  .pin-dot { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--border); }
  .pin-dot.filled { background: var(--gold); border-color: var(--gold); }
  .pin-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .pin-btn { background: var(--dark3); border: 1px solid var(--border); border-radius: 14px; padding: 18px; font-size: 22px; font-weight: 600; color: var(--text); cursor: pointer; text-align: center; }
  .pin-btn:active { border-color: var(--gold); }
  .pin-error { color: var(--danger); font-size: 13px; text-align: center; margin-top: 12px; }

  /* ADMIN */
  .admin-section { margin-bottom: 16px; }
  .admin-title { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; }
  .admin-card { background: var(--dark); border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; margin-bottom: 10px; }
  .admin-row { display: flex; align-items: center; justify-content: space-between; padding: 13px 16px; border-bottom: 1px solid var(--border); }
  .admin-row:last-child { border-bottom: none; }
  .admin-row-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .admin-row-sub { font-size: 11px; color: var(--text3); margin-top: 2px; }
  .admin-row-val { font-size: 15px; font-weight: 700; color: var(--gold); }

  #toast { position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--dark2); color: var(--text); border: 1px solid var(--gold); border-radius: 20px; padding: 11px 22px; font-size: 13px; opacity: 0; transition: all 0.22s ease; pointer-events: none; white-space: nowrap; z-index: 200; }
  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  #toast.undo { border-color: var(--danger); color: var(--danger); }

  .empty-state { padding: 32px 16px; text-align: center; color: var(--text3); font-size: 14px; }
  .empty-icon { font-size: 40px; margin-bottom: 10px; }

  #loading { position: fixed; inset: 0; background: var(--black); display: flex; align-items: center; justify-content: center; z-index: 300; flex-direction: column; gap: 16px; }
  .loading-logo { font-size: 20px; font-weight: 800; letter-spacing: 0.14em; background: linear-gradient(135deg, var(--gold) 0%, var(--gold-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .spinner { width: 28px; height: 28px; border: 2px solid var(--border); border-top-color: var(--gold); border-radius: 50%; animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>

<div id="loading"><div class="loading-logo">✦ VED</div><div class="spinner"></div></div>

<!-- OVERLAY CORSA -->
<div class="overlay" id="corsa-overlay">
  <div class="sheet"><div class="sheet-handle"></div>
    <h3 id="corsa-title">Nuova corsa</h3><p id="corsa-sub">Registra una corsa manualmente</p>
    <div class="field-label">Cliente</div><input class="field-input" type="text" id="c-cliente" placeholder="Es. Marco Rossi">
    <div class="field-label">Telefono</div><input class="field-input" type="tel" id="c-telefono" placeholder="+39 347 1234567" inputmode="tel">
    <div class="field-label">Tipo di servizio</div>
    <select class="field-select" id="c-servizio">
      <option value="Trasferimento Aeroporto">✈️ Trasferimento Aeroporto</option>
      <option value="Transfer Business">🏨 Transfer Business</option>
      <option value="Servizio Serale">🌙 Servizio Serale & Eventi</option>
      <option value="City Tour">🗺️ City Tour Privato</option>
      <option value="Altro">📍 Altro</option>
    </select>
    <div class="row-2">
      <div><div class="field-label">Data</div><input class="field-input" type="date" id="c-data"></div>
      <div><div class="field-label">Ora</div><input class="field-input" type="time" id="c-ora"></div>
    </div>
    <div class="field-label">Partenza</div><input class="field-input" type="text" id="c-partenza" placeholder="Es. Mestre, Stazione">
    <div class="field-label">Destinazione</div><input class="field-input" type="text" id="c-destinazione" placeholder="Es. Aeroporto Marco Polo">
    <div class="field-label">Importo (€)</div><input class="field-input" type="number" id="c-importo" inputmode="decimal" placeholder="Es. 120">
    <div class="field-label">Km percorsi (opzionale)</div><input class="field-input" type="number" id="c-km" inputmode="decimal" placeholder="Es. 45">
    <div class="field-label">Note (opzionale)</div><input class="field-input" type="text" id="c-note" placeholder="Es. numero volo, richieste speciali...">
    <button class="btn-gold" onclick="salvaCorsa()">Salva corsa</button>
    <button class="btn-danger" id="btn-elimina-corsa" onclick="eliminaCorsa()" style="display:none">Elimina corsa</button>
    <button class="btn-cancel" onclick="chiudiOverlay('corsa-overlay')">Annulla</button>
  </div>
</div>

<!-- OVERLAY COMPLETA CORSA -->
<div class="overlay" id="completa-overlay">
  <div class="sheet"><div class="sheet-handle"></div>
    <h3>Completa la corsa</h3><p id="completa-sub">Inserisci i costi per calcolare il margine</p>
    <div class="costi-box" id="completa-riepilogo"></div>
    <div class="field-label">Importo finale incassato (€)</div><input class="field-input" type="number" id="comp-importo" inputmode="decimal">
    <div class="field-label">Costo carburante (€)</div><input class="field-input" type="number" id="comp-carburante" inputmode="decimal" placeholder="Es. 18" oninput="aggiornaMarginePreview()">
    <div class="field-label">Pedaggi autostrada (€)</div><input class="field-input" type="number" id="comp-pedaggi" inputmode="decimal" placeholder="Es. 6" oninput="aggiornaMarginePreview()">
    <div class="field-label">Altri costi (€)</div><input class="field-input" type="number" id="comp-altri" inputmode="decimal" placeholder="Es. parcheggio, sosta..." oninput="aggiornaMarginePreview()">
    <div class="field-label">Km percorsi</div><input class="field-input" type="number" id="comp-km" inputmode="decimal" placeholder="Es. 45">
    <div class="costi-box" id="margine-preview" style="display:none">
      <div class="costi-row"><span class="costi-label">Incasso</span><span class="costi-val" id="mp-incasso">—</span></div>
      <div class="costi-row"><span class="costi-label">Costi totali</span><span class="costi-val red" id="mp-costi">—</span></div>
      <div class="costi-row"><span class="costi-label">Margine netto</span><span class="costi-val green" id="mp-margine">—</span></div>
    </div>
    <button class="btn-success" onclick="confermaCompleta()">✓ Segna come completata</button>
    <button class="btn-cancel" onclick="chiudiOverlay('completa-overlay')">Annulla</button>
  </div>
</div>

<!-- OVERLAY PIN -->
<div class="overlay" id="pin-overlay">
  <div class="sheet"><div class="sheet-handle"></div>
    <h3>Area Admin</h3><p>Inserisci il PIN per accedere</p>
    <div class="pin-dots" id="pin-dots">
      <div class="pin-dot" id="d0"></div><div class="pin-dot" id="d1"></div>
      <div class="pin-dot" id="d2"></div><div class="pin-dot" id="d3"></div>
    </div>
    <div class="pin-grid">
      <button class="pin-btn" onclick="pinPress('1')">1</button><button class="pin-btn" onclick="pinPress('2')">2</button><button class="pin-btn" onclick="pinPress('3')">3</button>
      <button class="pin-btn" onclick="pinPress('4')">4</button><button class="pin-btn" onclick="pinPress('5')">5</button><button class="pin-btn" onclick="pinPress('6')">6</button>
      <button class="pin-btn" onclick="pinPress('7')">7</button><button class="pin-btn" onclick="pinPress('8')">8</button><button class="pin-btn" onclick="pinPress('9')">9</button>
      <button class="pin-btn"></button><button class="pin-btn" onclick="pinPress('0')">0</button><button class="pin-btn" style="font-size:16px;color:var(--text3)" onclick="pinDel()">⌫</button>
    </div>
